# Keep the Docker build context clean, so a *local* `docker build` or
# `repo2docker` run does not drag host build artefacts (e.g. macOS binaries and
# object files) into the Linux image. mybinder.org builds from a fresh git
# clone and never sees these anyway.
.git
.gitignore
.github

# macOS
.DS_Store
**/.DS_Store

# Python
**/__pycache__
**/*.py[cod]
build/
dist/
*.egg-info
src/*.egg-info

# Cython output and compiled extensions: regenerated inside the image
src/operator_gb/*.c
src/operator_gb/*.so

# CaDiCaL is configured and built inside the image
includes/cadical/build
src/operator_gb/cadical

# Generated by cadical/configure
includes/cadical/src/makefile
